@page "/register"
@using WriterCo.Components.Layout
@layout AuthLayout
<div class="auth-form">
    <input type="text" class="auth-input" placeholder="Enter Username" />
    <input type="email" class="auth-input" placeholder="Enter Email" />
    <input type="password" class="auth-input" placeholder="Enter Password" />

    <button class="auth-btn" @onclick="GoToDashboard">Sign Up</button>

    <p class="auth-footer">
        Already have an account? <span @onclick="Login" class="nav-link">Log In</span>
    </p>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void Login()
    {
        Navigation.NavigateTo("/login");
    }
    private void GoToDashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }
}