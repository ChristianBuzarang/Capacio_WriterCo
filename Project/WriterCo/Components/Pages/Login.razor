@page "/login"
@using WriterCo.Components.Layout
@layout AuthLayout
<div class="auth-form">
    <input type="email" class="auth-input" placeholder="Enter Email" />
    <input type="password" class="auth-input" placeholder="Enter Password" />

    <button class="auth-btn" @onclick="GoToDashboard">Log In</button>

    <p class="auth-footer">
        Don't have an account? <span @onclick="Register" class="nav-link">Sign Up</span>
    </p>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void Register()
    {
        Navigation.NavigateTo("/register");
    }
    private void GoToDashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }
}